[Unit]
Description=DataStage runtime preflight for release %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=datastage
Group=datastage
WorkingDirectory=/opt/datastage/releases/%i/backend
EnvironmentFile=/etc/datastage/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/datastage/releases/%i/.venv/bin/python -m app.cli.preflight
TimeoutStartSec=120
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/datastage/documents
StandardOutput=journal
StandardError=journal
