# /etc/datastage/migration.env: root:root 0600. Only the migration unit reads this.
# Same server/database as runtime.env; a DIFFERENT SQL login with DDL permission.
# URL-encode credentials. Never commit real values.
DATASTAGE_MIGRATION_DATABASE_URL='mssql+pyodbc://REPLACE_MIGRATION_LOGIN:REPLACE_URL_ENCODED_PASSWORD@REPLACE_SQL_FQDN:1433/REPLACE_DATABASE?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no'
