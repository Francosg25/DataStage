# /etc/datastage/runtime.env: root:root 0600; systemd reads before dropping privileges.
# Fill placeholders with IT. No shell expansion; quote the entire URL.
DATASTAGE_ENVIRONMENT=production
DATASTAGE_AUTH_MODE=entra
DATASTAGE_SCOPE_ID=REPLACE_SCOPE
DATASTAGE_DATABASE_URL='mssql+pyodbc://REPLACE_RUNTIME_LOGIN:REPLACE_URL_ENCODED_PASSWORD@REPLACE_SQL_FQDN:1433/REPLACE_DATABASE?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no'
DATASTAGE_DOCUMENT_ROOT=/var/lib/datastage/documents
DATASTAGE_PROJECT_MAPS_ROOT=/var/lib/datastage/reference/project-maps
DATASTAGE_PART_CATALOG_FILE=/var/lib/datastage/reference/part_numbers.json
DATASTAGE_CORS_ORIGINS='["https://REPLACE_PUBLIC_FQDN"]'
DATASTAGE_ENTRA_TENANT_ID=REPLACE_TENANT_ID
DATASTAGE_ENTRA_CLIENT_ID=REPLACE_SPA_CLIENT_ID
DATASTAGE_ENTRA_AUDIENCE=REPLACE_API_AUDIENCE
DATASTAGE_ENTRA_API_SCOPE=REPLACE_API_SCOPE
DATASTAGE_MAX_UPLOAD_MB=50
DATASTAGE_MAX_FILE_MB=100
DATASTAGE_MAX_EXTRACTED_MB=500
DATASTAGE_MAX_ZIP_ENTRIES=2000
DATASTAGE_MAX_COMPRESSION_RATIO=500
DATASTAGE_WORKER_POLL_SECONDS=2
DATASTAGE_JOB_LEASE_SECONDS=120
DATASTAGE_MAX_JOB_ATTEMPTS=4
DATASTAGE_AUTO_ANNUAL=true
DATASTAGE_FOUNDRY_ENABLED=false
DATASTAGE_ALLOW_AGENT_COMMANDS=false
DATASTAGE_FOUNDRY_AUTH_MODE=default
# Optional Foundry: complete these before enabling. Never use a personal browser cache in production.
# DATASTAGE_FOUNDRY_PROJECT_ENDPOINT=https://REPLACE_RESOURCE.services.ai.azure.com/api/projects/REPLACE_PROJECT
# DATASTAGE_FOUNDRY_AGENT_NAME=datastage-assistant
# DATASTAGE_FOUNDRY_AGENT_VERSION=REPLACE_EXACT_VERSION
# DATASTAGE_FOUNDRY_MODEL=REPLACE_DEPLOYMENT_NAME
# TI configures a managed/workload identity where supported, or an approved service identity.
# For an internal Linux host using a service principal with a certificate:
# AZURE_TENANT_ID=REPLACE_FOUNDRY_TENANT_ID
# AZURE_CLIENT_ID=REPLACE_BACKEND_SERVICE_CLIENT_ID
# AZURE_CLIENT_CERTIFICATE_PATH=/etc/datastage/REPLACE_SERVICE_CERTIFICATE.pem
# The service account needs read access to the private certificate; it is provisioned separately.
