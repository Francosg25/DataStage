# Copy to deploy/compose.env; use a secret manager for real environments.
MSSQL_SA_PASSWORD=
# Match the SQL password above, URL-encoding special characters.
DATASTAGE_DATABASE_URL=mssql+pyodbc://sa:URL_ENCODED_PASSWORD@sql:1433/DataStage?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
DATASTAGE_ENTRA_TENANT_ID=
DATASTAGE_ENTRA_CLIENT_ID=
DATASTAGE_ENTRA_AUDIENCE=
DATASTAGE_ENTRA_API_SCOPE=
DATASTAGE_SCOPE_ID=integration
DATASTAGE_CORS_ORIGINS=["http://127.0.0.1:4200","http://localhost:4200"]
DATASTAGE_FOUNDRY_ENABLED=false
DATASTAGE_ALLOW_AGENT_COMMANDS=false
