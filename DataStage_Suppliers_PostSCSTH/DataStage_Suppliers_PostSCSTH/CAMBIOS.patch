+def _automatic_matches(items, data, known_tax_ids):
+    """Use a unique legal identity before optional address/source formatting.
+
+    A fuzzy name alone is never sufficient. Minor typos need either the same
+    fiscal ID or a matching street and location in the same country. Different
+    known fiscal IDs remain separate even when names and addresses look alike.
+    """
+    ranked = {"tax": [], "name": [], "legal": [], "address": []}
+    name, tax_id = normalized(data.get("name")), fiscal(data.get("taxId"))
+    for item in items:
+        if not name or data.get("identityConflict"):
+            continue
+        known = {fiscal(item.tax_id)} - {""}
+        known.update(known_tax_ids.get(item.id, set()))
+        same_tax = bool(tax_id and tax_id in known)
+        if tax_id and known and not same_tax:
+            continue
+        if item.kind != data["type"] and not _provisional_country(data):
+            continue
+        same_country = bool(data.get("country") and data["country"] == item.country)
+        if not same_country and not _provisional_country(data):
+            continue
+        same_name = item.name_key == name
+        legal_name = _name_core(item.name) == _name_core(data.get("name"))
+        ratio = SequenceMatcher(None, item.name_key, name).ratio() if min(len(name), len(item.name_key)) > 6 else 0
+        rfc_name = bool(RFC.fullmatch(item.name.upper()))
+        location = _supplier_data(item)
+        street = normalized(data.get("address"))
+        address_support = (same_country and street and street == normalized(location.get("address"))
+                           and any(normalized(data.get(field)) and normalized(data.get(field)) == normalized(location.get(field))
+                                   for field in ("postalCode", "city")))
+        if same_tax and (same_name or legal_name or rfc_name or ratio >= .94):
+            ranked["tax"].append(item)
+        elif same_name:
+            ranked["name"].append(item)
+        elif legal_name:
+            ranked["legal"].append(item)
+        elif ratio >= .97 and address_support:
+            ranked["address"].append(item)
+    return next((matches for matches in ranked.values() if matches), [])
+
+
+def _review_key(observation):
