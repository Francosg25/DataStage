# Copy to backend/.env for manual local execution. Never commit real secrets.
DATASTAGE_ENVIRONMENT=development
DATASTAGE_AUTH_MODE=development
DATASTAGE_SCOPE_ID=local
DATASTAGE_CORS_ORIGINS=["http://127.0.0.1:4200","http://localhost:4200"]
DATASTAGE_MAX_UPLOAD_MB=50
DATASTAGE_MAX_EXTRACTED_MB=500
DATASTAGE_MAX_FILE_MB=100
DATASTAGE_MAX_ZIP_ENTRIES=2000
DATASTAGE_MAX_COMPRESSION_RATIO=500
DATASTAGE_MAX_ROWS=1048575
DATASTAGE_MAX_COLUMNS=1024
DATASTAGE_ASC_ENCODING=utf-8-sig
DATASTAGE_AMBIGUOUS_DATE_ORDER=DMY
DATASTAGE_PREFERRED_DATE_HEADERS=["FechaPagoReal","FechaValidacionPagoR","FechaPago","FechaOperacion","FechaRecepcionPedimento"]
DATASTAGE_WORKER_POLL_SECONDS=2
DATASTAGE_JOB_LEASE_SECONDS=120
DATASTAGE_MAX_JOB_ATTEMPTS=4
DATASTAGE_AUTO_ANNUAL=true
DATASTAGE_FOUNDRY_ENABLED=false
# Optional private analytics snapshot, created with app.cli.analytics_reference.
# DATASTAGE_ANALYTICS_REFERENCE_FILE=C:/path/to/.data/analytics-reference.json
DATASTAGE_ALLOW_AGENT_COMMANDS=false
# Entra deployment settings (all four required when AUTH_MODE=entra):
# DATASTAGE_ENTRA_TENANT_ID=
# DATASTAGE_ENTRA_CLIENT_ID=
# DATASTAGE_ENTRA_AUDIENCE=
# DATASTAGE_ENTRA_API_SCOPE=
# Production: inject a secret URL. Escape username/password URL characters.
# DATASTAGE_DATABASE_URL=mssql+pyodbc://user:password@sql.example.invalid:1433/DataStage?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# DATASTAGE_DOCUMENT_ROOT=/var/lib/datastage/documents
# DATASTAGE_ANTIVIRUS_COMMAND=["clamscan","--no-summary","--database=/var/lib/clamav"]
# DATASTAGE_ANTIVIRUS_TIMEOUT_SECONDS=120
# DATASTAGE_FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# DATASTAGE_FOUNDRY_AGENT_NAME=datastage-assistant
# DATASTAGE_FOUNDRY_AGENT_VERSION=1
# DATASTAGE_FOUNDRY_MODEL=
